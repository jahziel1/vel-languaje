{
  "name": "vel-lang",
  "displayName": "Vel",
  "description": "Syntax highlighting for the Vel programming language",
  "version": "0.1.0",
  "publisher": "vel-lang",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "vel",
        "aliases": ["Vel", "vel"],
        "extensions": [".vel"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vel",
        "scopeName": "source.vel",
        "path": "./syntaxes/vel.tmLanguage.json"
      }
    ]
  }
}
